# Portal Malb Imóveis — variáveis de ambiente (Fase 6)
#
# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Nenhuma variável aqui é obrigatória: sem um ".env", o servidor sobe com os
# mesmos defaults de desenvolvimento usados desde a Fase 2 (porta 3001, CORS
# aberto, banco em backend/data/malb.db). Para usar o ".env", suba o servidor
# assim (suportado nativamente pelo Node 20.6+, sem precisar de nenhum pacote):
#
#   node --env-file=.env src/server.js
#
# O ".env" nunca deve ser commitado (já está no .gitignore) — cada ambiente
# (sua máquina, o servidor de produção) tem o seu próprio.

# Ambiente: "development" (padrão) ou "production". Em produção, habilita o
# cabeçalho HSTS quando a conexão chega via HTTPS (ver TRUST_PROXY abaixo).
NODE_ENV=production

# Porta em que o servidor Node escuta. Em produção, normalmente fica atrás de
# um proxy reverso (Caddy/nginx) que expõe as portas 80/443 publicamente —
# ver infra/docker-compose.yml.
PORT=3001

# Domínio do site público, usado para restringir quem pode chamar a API
# diretamente do navegador (CORS). Em desenvolvimento, deixe "*".
ALLOWED_ORIGIN=https://malbimoveis.com.br

# Só ligue isto se o servidor estiver de fato atrás de um proxy reverso
# confiável (como o Caddy do infra/docker-compose.yml) que sobrescreve o
# cabeçalho X-Forwarded-For com o IP real do visitante. Ligar isso sem um
# proxy na frente permite que qualquer requisição falsifique seu próprio IP
# e escape do rate limiting.
TRUST_PROXY=true

# Caminho do arquivo do banco SQLite. Deixe em branco para usar o padrão
# (backend/data/malb.db). No infra/docker-compose.yml isso aponta para
# /data/malb.db, dentro de um volume Docker persistente.
DB_PATH=

# Rate limiting dos dois endpoints públicos mais sensíveis a abuso
# automatizado. Os valores abaixo são os defaults (podem ser omitidos).
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LEAD_WINDOW_MS=3600000
RATE_LIMIT_LEAD_MAX=20

# Envio de e-mail (convite de acesso para novos usuários da equipe, "esqueci
# minha senha" e aviso de login) — ver backend/src/email.js. Sem essas
# variáveis, o sistema não quebra: os e-mails só são registrados no console
# em vez de enviados de verdade, o que já é suficiente para testar em
# desenvolvimento local.
#
# Para usar o Gmail, é preciso gerar uma "senha de app" em
# myaccount.google.com/apppasswords (exige verificação em duas etapas
# ativada na conta) — a senha normal da conta Google NÃO funciona aqui.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=malbimoveis@gmail.com
SMTP_PASS=
SMTP_FROM=malbimoveis@gmail.com
